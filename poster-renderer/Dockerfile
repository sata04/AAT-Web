# The AAT poster renderer.
#
# Everything that can move a pixel is pinned: the base image by digest, the Python packages by
# version and hash, the font by virtue of shipping inside the Matplotlib wheel. Rebuilding this
# Dockerfile a year from now produces a container that draws the same figure — which is the only
# reason a poster generated by AAT Web can be compared with one exported by the desktop app.
#
# Not installed, deliberately: pandas, openpyxl, PySide6, any GUI toolkit, any system font
# package, any web framework. This image renders one kind of figure and does nothing else.

# ---------------------------------------------------------------------------------------------
# Base image
# ---------------------------------------------------------------------------------------------
# Pinned by digest, not by tag: `python:3.12-slim-bookworm` is a moving target that is
# re-published whenever Debian or CPython gets a patch, and a rebuilt FreeType or zlib can change
# rendered bytes. The tag is kept alongside the digest for human readability only — the digest is
# what Docker resolves.
#
# Resolved 2026-08-12 from the Docker Hub registry API:
#   TOKEN=$(curl -s "https://auth.docker.io/token?service=registry.docker.io&scope=repository:library/python:pull" | jq -r .token)
#   curl -sI -H "Authorization: Bearer $TOKEN" \
#        -H "Accept: application/vnd.oci.image.index.v1+json" \
#        https://registry-1.docker.io/v2/library/python/manifests/3.12-slim-bookworm \
#     | grep -i docker-content-digest
#
# The index it names was built 2026-08-05 from debian:bookworm-slim
# (org.opencontainers.image.base.digest
#  sha256:362e64223cc0da95422b3b13c045186fc0a81250e765d31c025fbddf257f6143).
#
# Renovate keeps this digest fresh, but poster-renderer updates never auto-merge: a base-image
# bump is a visual-contract change and needs the review in README.md.
FROM python:3.14-slim-bookworm@sha256:23c59390fc717bf09f9336908199a0ae75d9c4264bf296123f94ad772fea3b52 AS base

# ---------------------------------------------------------------------------------------------
# Build stage: install dependencies into an isolated prefix
# ---------------------------------------------------------------------------------------------
FROM base AS builder

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_ROOT_USER_ACTION=ignore

WORKDIR /build
COPY requirements.txt ./

# `--require-hashes` makes pip refuse the whole file unless every requirement is pinned with a
# hash, so this line is what turns requirements.txt's hashes into an enforced supply-chain gate.
# `--only-binary=:all:` refuses to build anything from source: a locally compiled Matplotlib would
# link a different FreeType than the wheel bundles, and would render different glyphs.
RUN python -m pip install \
        --require-hashes \
        --only-binary=:all: \
        --no-deps \
        --prefix=/install \
        -r requirements.txt

# Matplotlib's sample datasets are documentation assets that nothing here can reach.
#
# Nothing else is pruned, and specifically not the bundled fonts or the compiled bytecode. Deleting
# fonts to save a few hundred kilobytes would put the font manager one upgrade away from resolving
# a different face; deleting `__pycache__` would make every worker respawn recompile Matplotlib,
# which is exactly the path a render timeout takes.
RUN rm -rf /install/lib/python3.12/site-packages/matplotlib/mpl-data/sample_data

# ---------------------------------------------------------------------------------------------
# Runtime stage
# ---------------------------------------------------------------------------------------------
FROM base AS runtime

# MPLBACKEND is also forced in `poster_renderer/__init__.py`; setting it here as well means even
# an ad-hoc `python -c` inside the container cannot pick up an interactive backend.
# MPLCONFIGDIR points at a directory the non-root user owns, so Matplotlib's font cache is written
# once at build time and never rebuilt at runtime (a read-only or unwritable config dir would make
# the first render slow and noisy).
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app/src \
    MPLBACKEND=Agg \
    MPLCONFIGDIR=/app/.mplconfig \
    POSTER_PORT=8080

COPY --from=builder /install /usr/local

WORKDIR /app
COPY src/ /app/src/
COPY tests/ /app/tests/
COPY pytest.ini /app/pytest.ini

# A dedicated unprivileged user with no login shell and no home directory to write to. Everything
# the process needs to write (the Matplotlib cache) is created here, at build time, and nothing
# else in the image is writable by it.
RUN useradd --no-create-home --shell /usr/sbin/nologin --uid 10001 poster \
 && mkdir -p /app/.mplconfig \
 && chown -R poster:poster /app/.mplconfig \
 && chmod 700 /app/.mplconfig

USER poster

# Draw one throwaway figure at build time. This writes Matplotlib's font cache into the image (so
# no request ever pays for a font scan, and no runtime write to MPLCONFIGDIR is needed) and fails
# the build outright if the pinned stack cannot rasterise text.
RUN python -c "\
import io; \
from matplotlib.backends.backend_agg import FigureCanvasAgg; \
from matplotlib.figure import Figure; \
import poster_renderer.render as render; \
figure = Figure(figsize=(2, 1)); FigureCanvasAgg(figure); \
axes = figure.add_subplot(111); axes.set_title('warm'); \
buffer = io.BytesIO(); figure.savefig(buffer, format='png'); \
print('font cache warmed:', len(buffer.getvalue()), 'bytes;', render.PNG_METADATA['Software'])"

EXPOSE 8080

# The renderer needs no network access of its own: it never fetches fonts, data or updates, so it
# is expected to run with no outbound connectivity at all (CI runs it with `--network none`).
# The probe reads POSTER_PORT at run time rather than hardcoding it, so a container started on a
# different port still reports its health correctly.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "\
import os, sys, urllib.request; \
port = os.environ.get('POSTER_PORT', '8080'); \
sys.exit(0 if urllib.request.urlopen(f'http://127.0.0.1:{port}/health', timeout=4).status == 200 else 1)"

# CMD, deliberately not ENTRYPOINT. An exec-form ENTRYPOINT would turn `docker run <image> python
# -m pytest /app/tests` into arguments *appended to* the server's command line rather than a
# replacement for it, and the container would quietly start serving instead of running the tests —
# which is exactly how CI and deploy.yml invoke this image.
CMD ["python", "-m", "poster_renderer"]
