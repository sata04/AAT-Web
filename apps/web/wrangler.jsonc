{
  "$schema": "./node_modules/wrangler/config-schema.json",
  /*
   * The private API Worker.
   *
   * It has no route, no custom domain and no workers.dev subdomain. The only way
   * in is the Service binding declared by the Pages project, which is what makes
   * the public origin single: one hostname serves the SPA and answers /api/*, so
   * the passkey ceremony, the session cookie and the browser's relative fetches
   * all see the same origin. See functions/api/[[path]].ts.
   *
   * Named for what it is rather than for the product, because the Pages project
   * is the thing users reach and two objects with one name in the Workers & Pages
   * list is a trap to hit during an incident.
   */
  "name": "aat-api",
  "main": "worker/index.ts",

  /*
   * No public origin, stated in the file rather than clicked in the dashboard.
   *
   * The dashboard toggle does not survive: the next `wrangler deploy` re-opens
   * the platform-assigned subdomain, which would be a second origin serving the
   * same API — a second WebAuthn origin that no ceremony would validate against,
   * and an unauthenticated-looking entry point straight to D1 and R2. The config
   * key is the only durable control.
   *
   * preview_urls defaults to whatever workers_dev is, but it is written out so
   * that turning workers_dev back on some day does not quietly restore preview
   * origins as well.
   */
  "workers_dev": false,
  "preview_urls": false,

  // workerd 1.20260730.x is what this repository pins; the compatibility date
  // must not be newer than the runtime that is actually installed.
  "compatibility_date": "2026-07-30",

  /*
   * "nodejs_compat" is required, not optional, and it is worth knowing why.
   *
   * Better Auth resolves @better-auth/utils/password through its "workerd"
   * export condition, which is a build that does `import { randomBytes, scrypt }
   * from "node:crypto"` at the top level. AAT never hashes a password — there is
   * no password anywhere in this system — but that import is static, so without
   * the flag the module graph fails to evaluate and the Worker does not boot at
   * all. Better Auth's own AsyncLocalStorage-based request context (used to
   * attach the request's IP and user agent to a session) also comes from
   * node:async_hooks.
   *
   * The cost is bundle size, which scripts/check-worker-bundle-size.mjs
   * measures on every CI run against a limit with generous headroom.
   */
  "compatibility_flags": ["nodejs_compat"],

  /*
   * Asset-first routing (Workers Static Assets, not the legacy Workers Sites).
   *
   * Every request is served from the static asset store unless it matches
   * `run_worker_first`, so the React SPA — the part that must keep working with
   * no account and no network — never pays for a Worker invocation. Better
   * Auth mounts itself under /api/auth, so a single /api/* rule covers both the
   * versioned application API and the auth path.
   *
   * `single-page-application` makes unmatched non-asset paths fall back to
   * index.html, which is what client-side routes such as /register?token=...
   * need.
   */
  // There is no "assets" block. Pages serves dist/client now, and each of the
  // four things this block used to do has a new owner:
  //
  //   directory / html_handling  -> the Pages project's build output
  //   not_found_handling: "single-page-application"
  //                              -> implicit on Pages, and implicit is the word:
  //                                 Pages serves the root document for unmatched
  //                                 paths only while dist/client contains no
  //                                 top-level 404.html. There is no config key
  //                                 for it, so scripts/check-pages-output.mjs
  //                                 asserts the file's absence after every build.
  //   run_worker_first: ["/api/*"]
  //                              -> public/_routes.json. That file is what keeps
  //                                 the logged-out, offline-first path free of
  //                                 Function invocations, which docs/web-architecture.md
  //                                 treats as the governing principle. Note that
  //                                 `wrangler pages dev` ignores _routes.json, so
  //                                 the end-to-end suite cannot verify it; the
  //                                 deploy asserts it instead.
  //   binding: "ASSETS"          -> gone. Nothing in worker/ ever called it.

  /*
   * D1 holds the structured index only: users, runs, immutable analysis
   * revisions, headline metrics, poster bookkeeping, quotas and the audit log.
   * Time series never land here — a 20 s run at 1 kHz is 20,000 samples per
   * channel, and that belongs in R2 as one snapshot object.
   *
   * database_id must be replaced with the id printed by `wrangler d1 create
   * aat-db` for the target account. It is an account-scoped identifier, not a
   * secret, so it is committed rather than injected — but this repository has
   * never been deployed, so the placeholder below is intentionally invalid and
   * a deploy fails loudly rather than writing to some other account's database.
   */
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aat-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  /*
   * Private bucket. There is no public R2 URL and no signed-URL issuance:
   * every read goes through the Worker so ownership is checked on the way out.
   */
  "r2_buckets": [
    {
      "binding": "AAT_OBJECTS",
      "bucket_name": "aat-objects"
    }
  ],

  // No durable_objects, migrations or containers: posters are drawn in the browser — Pyodide +
  // Matplotlib in WASM — and POSTed back, so the Worker only validates and records uploaded PNGs.

  /*
   * Non-secret tunables. Anything that would identify the deployment (hostname,
   * relying-party id) is a secret instead — see "secrets" below.
   */
  "vars": {
    /**
     * The whole cloud API's kill switch. The literal string 'false' makes every /api/* request a
     * 404 answered before any secret is read — so a deployment running SPA-only needs none of the
     * values in "secrets" below set at all. Anything else, including unset, means enabled.
     */
    "AAT_CLOUD_ENABLED": "true",
    /** Per-user storage ceiling applied on first use. Cost guard, adjustable per user by an admin. */
    "AAT_DEFAULT_QUOTA_BYTES": "1073741824",
    /** Largest accepted analysis snapshot (gzipped). Bounds Worker memory as well as storage. */
    "AAT_MAX_SNAPSHOT_BYTES": "16777216",
    /** Largest accepted original CSV backup. */
    "AAT_MAX_SOURCE_BYTES": "33554432",
    /** Largest accepted poster PNG uploaded by the client. */
    "AAT_MAX_POSTER_BYTES": "8388608",
    /** Seconds a quota reservation may stay pending before the sweeper reclaims it. */
    "AAT_RESERVATION_TTL_SECONDS": "900"
  },

  /*
   * Declared, never committed. `wrangler dev` warns when one is missing and
   * `wrangler types` uses this list instead of guessing from .dev.vars.
   *
   * AAT_RP_ID is the WebAuthn relying-party id and AAT_TRUSTED_ORIGINS the
   * exact origins allowed to complete a passkey ceremony. Both are derived from
   * the production hostname, which is deliberately not in this repository.
   * Getting the RP ID wrong does not degrade gracefully: every passkey already
   * registered against the old value stops being offered by the authenticator,
   * which is indistinguishable from every user losing their credential. The
   * Worker therefore refuses to start an auth flow when they are absent rather
   * than inventing a default from the request's Host header, which an attacker
   * controls.
   */
  "secrets": {
    "required": ["BETTER_AUTH_SECRET", "BETTER_AUTH_URL", "AAT_RP_ID", "AAT_RP_NAME", "AAT_TRUSTED_ORIGINS"]
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  /*
   * A runaway request is a runaway bill. Nothing in this Worker legitimately
   * needs 30 s of CPU: the heavy numerical work — including poster rendering —
   * happens in the browser, so the largest cost here is buffering an upload.
   */
  "limits": {
    "cpu_ms": 30000
  }
}
