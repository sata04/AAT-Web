{
  "name": "@aat/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/generate-headers.mjs",
    "preview": "pnpm build && vite preview",
    "typecheck": "tsc -b && tsc -p pages/tsconfig.json",
    "test": "vitest run && vitest run --config vitest.dom.config.ts && vitest run --config test/worker/vitest.config.ts",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply aat-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply aat-db --remote",
    "e2e": "playwright test",
    "test:worker": "vitest run --config test/worker/vitest.config.ts"
  },
  "dependencies": {
    "@aat/analysis-core": "workspace:*",
    "@aat/plot-spec": "workspace:*",
    "@aat/shared": "workspace:*",
    "@better-auth/passkey": "1.6.29",
    "@hono/zod-validator": "0.9.0",
    "better-auth": "1.6.29",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.3",
    "papaparse": "5.6.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ulid": "3.0.2",
    "uplot": "1.6.32",
    "write-excel-file": "4.1.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "1.51.0",
    "@cloudflare/vitest-pool-workers": "0.20.2",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.5",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "drizzle-kit": "0.31.10",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11",
    "wrangler": "4.119.0"
  }
}
